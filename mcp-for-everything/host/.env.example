# Copy to .env and adjust. Nothing here is required for the offline demos.

# PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe
# POWERSHELL_ROOT=D:\repos\cas2026\mcp-for-everything\powershell

HOST=127.0.0.1
PORT=8931
TOOL_TIMEOUT_SECONDS=45
HOT_RELOAD=true

# Safety rails. Leave these off until Demo 5.
ALLOW_WRITE_TOOLS=false
WRITE_TOOL_ALLOWLIST=

# Set to true to run every external-system tool from canned data in ./data.
# This is the wifi-died button.
CAS_DEMO_MODE=false

