# Copy to .env and adjust. Nothing here is required for the offline demos.

# PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe
TOOL_TIMEOUT_SECONDS=45

# State-changing tools are hidden unless named here, comma separated.
# There is deliberately no master on/off switch - you name the tool.
WRITE_TOOL_ALLOWLIST=

# Set to true to run every external-system tool from canned data in ./data.
# This is the wifi-died button. Read by the PowerShell tools, not by the host.
CAS_DEMO_MODE=false

# SQL_CONNECTION_STRING=Server=tcp:contoso.database.windows.net,1433;Database=Inventory;Authentication=Active Directory Default;
