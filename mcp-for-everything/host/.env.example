# Copy to .env. Start-Demo.ps1 reads this file; nothing else does.
# Nothing here is required for the offline demos.

# PWSH_PATH=C:\Program Files\PowerShell\7\pwsh.exe
TOOL_TIMEOUT_SECONDS=45

# State-changing tools are hidden unless named here, comma separated.
# Start-Demo.ps1 -AllowWriteTools sets this for you; leave it empty here.
WRITE_TOOL_ALLOWLIST=

# true = the SQL tool returns canned data from ./data. The wifi-died button.
CAS_DEMO_MODE=false

# Demo 2. Any SQL Server works. Use the read-only login that data/sql-setup.sql creates.
# SQL_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=Inventory;User Id=mcp_reader;Password=CHANGE-ME;TrustServerCertificate=True;
# SQL_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=Inventory;Integrated Security=True;
