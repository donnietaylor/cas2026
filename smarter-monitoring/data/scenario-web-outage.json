    "trace:4bf92f3577b34da6a3ce929d0e0e4736": {
      "severity": "critical",
      "title": "Checkout requests failing end-to-end on connection pool exhaustion",
      "rootCause": "All three failing spans share one trace: checkout timed out waiting on payments, which failed on a reset connection, while the order insert hit an exhausted SQL connection pool. The 13:47 checkout-api deploy moved connection disposal into a finally block and is the most likely trigger.",
      "recommendedAction": "Roll back checkout-api to 2026.8.24.2 and confirm pool utilisation on sql-prod-03 recovers. Do not scale the web tier - it is not the bottleneck.",
      "confidence": "high"
    },
    "resource:/subscriptions/00000000-1111-2222-3333-444444444444/resourceGroups/rg-prod-web/providers/Microsoft.Network/applicationGateways/appgw-prod": {
      "severity": "critical",
      "title": "Application Gateway serving 5xx with degraded backend pool",
      "rootCause": "Backend health dropped below two healthy instances and the 5xx rate crossed 10%. Consistent with the checkout failures on vmss-web rather than an independent gateway fault.",
      "recommendedAction": "Treat as a symptom of the checkout incident. Verify backend health recovers once checkout-api is rolled back.",
      "confidence": "medium"
    },
    "resource:/subscriptions/00000000-1111-2222-3333-444444444444/resourceGroups/rg-prod-web/providers/Microsoft.Compute/virtualMachineScaleSets/vmss-web": {
      "severity": "medium",
      "title": "Sustained CPU and memory pressure on vmss-web",
      "rootCause": "Three CPU alerts and one memory alert over ten minutes, all on the same scale set. Likely retry amplification from the failing checkout path rather than a genuine traffic increase.",
      "recommendedAction": "Do not scale out yet. Re-evaluate after the checkout rollback; if pressure persists, then scale.",
      "confidence": "medium"
    },
    "resource:/subscriptions/00000000-1111-2222-3333-444444444444/resourceGroups/rg-prod-data/providers/Microsoft.Sql/servers/sql-prod-03/databases/orders": {
      "severity": "high",
      "title": "sql-prod-03 saturated: DTU, deadlocks and pool exhaustion",
      "rootCause": "DTU above 90% with deadlocks and connection pool exhaustion on the orders database. Almost certainly the same root cause as the checkout failures - leaked connections from the 13:47 deploy.",
      "recommendedAction": "Confirm active connection count. If it does not fall after the checkout-api rollback, fail over and open a data-team escalation.",
      "confidence": "high"
    },
    "host:backup-01": {
      "severity": "low",
