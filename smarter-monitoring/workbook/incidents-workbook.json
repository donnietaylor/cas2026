{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "name": "header",
      "content": {
        "json": "# Monitoring pipeline\nOpenTelemetry &nbsp;&bull;&nbsp; Azure Monitor &nbsp;&bull;&nbsp; twelve third-party tools &nbsp;&rarr;&nbsp; one Event Hub &nbsp;&rarr;&nbsp; correlated incidents"
      }
    },
    {
      "type": 1,
      "name": "ask",
      "content": {
        "json": "## Everything that just arrived\nEvery failure event from every source, in the order it landed. Nothing merged, nothing ranked, nothing explained.\n\n**One of these caused all the others. Which one?**"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\": \"CustomEndpoint/1.0\", \"data\": null, \"headers\": [], \"method\": \"GET\", \"url\": \"https://func-cas26-193812.azurewebsites.net/api/incidents?view=raw\", \"batchDisabled\": false, \"transformers\": [{\"type\": \"jsonpath\", \"settings\": {\"tablePath\": \"$\", \"columns\": [{\"path\": \"$.Time\", \"columnid\": \"Time\", \"columnType\": \"string\"}, {\"path\": \"$.Severity\", \"columnid\": \"Severity\", \"columnType\": \"string\"}, {\"path\": \"$.Source\", \"columnid\": \"Source\", \"columnType\": \"string\"}, {\"path\": \"$.Tool\", \"columnid\": \"Tool\", \"columnType\": \"string\"}, {\"path\": \"$.Host\", \"columnid\": \"Host\", \"columnType\": \"string\"}, {\"path\": \"$.Event\", \"columnid\": \"Event\", \"columnType\": \"string\"}, {\"path\": \"$.Detail\", \"columnid\": \"Detail\", \"columnType\": \"string\"}]}}]}",
        "queryType": 10,
        "size": 3,
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Severity",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
